// Each #kernel tells which function to compile; you can have many kernels
#pragma kernel CSMain

RWStructuredBuffer<float3> _Positions;
RWStructuredBuffer<int> _TriIndices;

uint _Resolution;
float _ChunkSize;

// Create a RenderTexture with enableRandomWrite flag and set it
// with cs.SetTexture
RWTexture2D<float4> Result;

[numthreads(8,8,1)]
void CSMain (uint3 id : SV_DispatchThreadID)
{

    float3 startPos = float3(-1, 0, -1) * _ChunkSize * 0.5f;
    
    float2 percent = float2(id.x, id.y) /(_Resolution -1);

    int vertIndex = id.x + id.y * _Resolution

    if(id.x < _Resolution && id.< _Resolution)
    {
        _Positions[vertIndex] = startPos + (float3(1,0,0) * percent.x + float3(0,0,1) * percent.y) * _ChunkSize;
        
    }

    if(id.x < _Resolution -1 && id.y < _Resolution -1)
    {
        int triStartIdx = (id.x + id.y * (_Resolution -1)) * 6;

        _TriIndices[triStartIdx +0] =vertIndex;
        _TriIndices[triStartIdx +0] =vertIndex + _Resolution;
        _TriIndices[triStartIdx +0] =vertIndex + _Resolution + 1;

        _TriIndices[triStartIdx +0] =vertIndex;
        _TriIndices[triStartIdx +0] =vertIndex + _Resolution + 1;
        _TriIndices[triStartIdx +0] =vertIndex + 1;
    }
}
